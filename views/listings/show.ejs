
<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">
        <h1 class="listing-heading">Listing Details</h1>

        <div class="show-card">
            <img
                src="<%= newlisting.image.url %>"
                class="show-img"
                alt="listing_image"
            >

            <div class="show-details">
                <p>
                    <b>Owner:</b>
                    <%= newlisting.owner
                        ? newlisting.owner.username
                        : "Unknown User" %>
                </p>

                <h4><%= newlisting.title %></h4>
                <p><%= newlisting.description %></p>
                <p>₹ <%= newlisting.price.toLocaleString("en-IN") %></p>
                <p><%= newlisting.location %></p>
                <p><%= newlisting.country %></p>
            </div>

            <% if (currentUser && newlisting.owner &&
                currentUser._id.equals(newlisting.owner._id)) { %>
                <div class="show-buttons">
                    <a
                        href="/listings/<%= newlisting._id %>/edit"
                        class="btn edit-btn"
                    >Edit</a>

                    <form
                        action="/listings/<%= newlisting._id %>?_method=DELETE"
                        method="POST"
                        style="display:inline;"
                    >
                        <button class="btn delete-btn">
                            Delete Listing
                        </button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
</div>
<!-- Review Form -->
<div class="row">
    <div class="col-8 offset-2">
        <% if (currentUser) { %>
            <div class="review-section">
                <h3>Leave a Review</h3>

                <form
                    action="/listings/<%= newlisting._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation"
                >
                    <div class="mb-3">
                        <label class="form-label">Rating</label>

                        <fieldset class="starability-slot">
                            <legend>Choose your rating:</legend>

                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="0"
                                checked
                                aria-label="No rating."
                            />

                            <input type="radio" id="first-rate1"
                                name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>

                            <input type="radio" id="first-rate2"
                                name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>

                            <input type="radio" id="first-rate3"
                                name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>

                            <input type="radio" id="first-rate4"
                                name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>

                            <input type="radio" id="first-rate5"
                                name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            class="form-control"
                            rows="4"
                            required
                        ></textarea>

                        <div class="invalid-feedback">
                            Please add a comment.
                        </div>
                    </div>

                    <button class="btn edit-btn">Submit Review</button>
                </form>
            </div>
        <% } else { %>
            <p><a href="/login">Login</a> to leave a review.</p>
        <% } %>

        <!-- All Reviews -->
        <div class="review-section">
            <h3>All Reviews</h3>

            <div class="row">
                <% if (newlisting.reviews.length === 0) { %>
                    <p>No reviews yet.</p>
                <% } else { %>
                    <% newlisting.reviews.forEach(review => { %>
                        <div class="col-md-6 mb-4">
                            <div class="card review-card">
                                <div class="card-body">
                                    <h5>
                                        By: <%= review.author
                                            ? review.author.username
                                            : "Unknown User" %>
                                    </h5>

                                    <p
                                        class="starability-result"
                                        data-rating="<%= review.rating %>"
                                    ></p>

                                    <p class="card-text"><%= review.comment %></p>

                                    <small class="text-muted">
                                        <%= review.createdAt
                                            ? review.createdAt.toLocaleDateString()
                                            : "" %>
                                    </small>

                                    <% if (currentUser && review.author &&
                                        currentUser._id.equals(review.author._id)) { %>
                                        <form
                                            action="/listings/<%= newlisting._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST"
                                            style="display:inline;"
                                        >
                                            <button class="btn delete-btn">
                                                Delete Review
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 mb-4">
    <div class="col-8 offset-2">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";

    const coordinates = <%- JSON.stringify(
        newlisting.geometry.coordinates
    ) %>;
    const listingTitle = <%- JSON.stringify(newlisting.title) %>;

</script>

