<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">

        <h1 class="listing-heading">Login</h1>

        <form action="/login" method="POST" class="needs-validation" novalidate>

            <!-- Username -->
            <div class="mb-3">
                <label for="username" class="form-label">
                    Username
                </label>

                <input
                    name="username"
                    id="username"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a username.
                </div>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label for="password" class="form-label">
                    Password
                </label>

                <input
                    name="password"
                    id="password"
                    type="password"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a password.
                </div>
            </div>

            <button class="btn btn-success">
                Login
            </button>

        </form>

    </div>
</div>